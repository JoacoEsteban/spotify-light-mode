{
  "name": "spotify-light-mode",
  "version": "1.4.1",
  "description": "Bring light mode to Spotify's web player — always on, or only when your OS is in light mode.",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "postinstall": "wxt prepare",
    "screenshot": "bun scripts/screenshot.ts",
    "screenshot:fast": "bun scripts/screenshot.ts --skip-build",
    "screenshot:login": "bun scripts/screenshot.ts --login",
    "extract:spotify-css": "bun scripts/extract-spotify-css-files.ts",
    "fetch:spotify-css": "bun scripts/fetch-spotify-css-files.ts",
    "generate:spotify-light-css": "bun scripts/generate-spotify-light-css.ts",
    "refresh:spotify-light-css": "bun scripts/fetch-spotify-css-files.ts --generate",
    "ensure:spotify-light-css": "bun scripts/ensure-latest-spotify-light-css.ts",
    "regenerate": "bun scripts/generate-spotify-light-css.ts $(bun -p \"(await Bun.file('assets/spotify-light/css-manifest.json').json()).snapshotVersion\")"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "prettier": "^3.9.6",
    "puppeteer-core": "^24.42.0",
    "typescript": "5.8",
    "wxt": "^0.20.25"
  },
  "dependencies": {
    "@types/chroma-js": "^3.1.2",
    "chroma-js": "^3.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ts-pattern": "^5.9.0",
    "zod": "^4.3.6"
  }
}
